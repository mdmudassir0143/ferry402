{
  "name": "@ferry402/sdk",
  "version": "0.2.0",
  "description": "Accept x402 payments from users on other chains. Non-custodial escrow settlement with Hedera Consensus Service as the clearing ledger.",
  "keywords": [
    "x402",
    "payments",
    "hedera",
    "base",
    "usdc",
    "eip-3009",
    "eip-1271",
    "agent-payments",
    "micropayments"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmudassir0143/ferry402.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/mdmudassir0143/ferry402#readme",
  "bugs": {
    "url": "https://github.com/mdmudassir0143/ferry402/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "x402": "1.2.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.7.3",
    "viem": "^2.56.8",
    "vitest": "^3.0.5"
  },
  "private": false
}
