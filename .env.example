# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
# Testnet keys only. Nothing in this project is audited or intended for
# mainnet funds; see SECURITY.md.

# ─── Base Sepolia ──────────────────────────────────────────────────────────

# Public RPC endpoint. Not a secret.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deploys Escrow.sol (`forge create`). Needs testnet ETH for gas.
DEPLOYER_PRIVATE_KEY=

# Signs the facilitator's on-chain settlement transactions. Needs testnet ETH
# for gas; this wallet pays gas on the payer's behalf, which is what makes a
# ferry402 payment gasless for the payer.
FACILITATOR_PRIVATE_KEY=

# Signs EIP-3009 authorizations. Needs testnet USDC (not ETH — the payer
# never submits a transaction). Required by examples/demo and the gated e2e
# test; not needed to run a merchant or a facilitator.
PAYER_PRIVATE_KEY=

# Your deployed Escrow contract. Not a secret.
#
# This is NOT read automatically. `createFacilitatorApp()` takes its trusted
# escrow allowlist as an explicit option, and your bootstrap code must pass
# it in:
#
#   createFacilitatorApp({
#     escrows: { 'base-sepolia': process.env.ESCROW_ADDRESS_BASE_SEPOLIA },
#     rpcUrls: { 'base-sepolia': process.env.BASE_SEPOLIA_RPC_URL },
#     facilitatorPrivateKey: process.env.FACILITATOR_PRIVATE_KEY,
#   })
#
# `escrows` is a required option: omitting it throws at construction, and a
# network with no entry is rejected per request. An unauthenticated caller
# supplies `payTo`, so it has to be checked against something the operator
# configured rather than trusted. See packages/facilitator/README.md.
#
# This project's live deployment: 0x99Cd564B21fa7fD8553Cf31F32E448C17BBcC429
ESCROW_ADDRESS_BASE_SEPOLIA=

# ─── Hedera testnet ────────────────────────────────────────────────────────

# Operator account that submits HCS journal messages.
HEDERA_ACCOUNT_ID=

# The operator's private key.
#
# A DER-encoded ECDSA key (what the Hedera portal gives you for an ECDSA
# account, starting `3030020100300706...`) must be loaded with
# `PrivateKey.fromStringDer()` or `fromStringECDSA()`. Loading it with
# `fromStringED25519()` silently produces a different key and every
# submission fails with INVALID_SIGNATURE.
HEDERA_PRIVATE_KEY=

# The HCS topic the journal is written to. Not a secret.
# Create one with: pnpm --filter @ferry402/facilitator exec tsx scripts/create-topic.ts
#
# This project's live topic: 0.0.10719807
# https://hashscan.io/testnet/topic/0.0.10719807
HCS_TOPIC_ID=

# ─── Merchant ──────────────────────────────────────────────────────────────

# Shared secret for stateless challenge derivation. >= 32 bytes, and
# identical across every instance serving the same merchant — it is what lets
# two processes validate each other's challenges with no shared store.
# Generate with: openssl rand -hex 32
FERRY402_SECRET=

# ─── Test gating ───────────────────────────────────────────────────────────
#
# RUN_E2E=1 enables packages/facilitator/test/e2e.test.ts, which spends real
# testnet USDC and ETH against live networks. Unset, the file is collected and
# reported as skipped rather than silently absent, and needs no credentials.
