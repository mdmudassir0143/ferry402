# Copy to .env and fill in real values. Never commit .env.
# anychain402 — environment variables used across packages/contracts,
# packages/sdk and packages/facilitator as later tasks land.

# --- EVM (Base Sepolia) ---
# Public RPC endpoint; not a secret.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Funds contract deployments (e.g. `forge create`). Testnet key only.
DEPLOYER_PRIVATE_KEY=

# Funds the facilitator's on-chain settlement transactions. Testnet key only.
FACILITATOR_PRIVATE_KEY=

# Set after deploying Escrow.sol to Base Sepolia (Task 10). Not a secret.
#
# IMPORTANT: this value is NOT read automatically by @anychain402/facilitator.
# `createFacilitatorApp()` takes its trusted-escrow allowlist as an explicit
# `escrows: { 'base-sepolia': '0x...' }` option (keyed the same way as
# `rpcUrls`) -- an operator's own bootstrap code must read this variable and
# pass it in, e.g.:
#
#   createFacilitatorApp({
#     escrows: { 'base-sepolia': process.env.ESCROW_ADDRESS_BASE_SEPOLIA },
#     rpcUrls: { 'base-sepolia': process.env.BASE_SEPOLIA_RPC_URL },
#     facilitatorPrivateKey: process.env.FACILITATOR_PRIVATE_KEY,
#   })
#
# A network with NO entry in `escrows` is rejected outright (fail-closed):
# `createFacilitatorApp()` called with no `escrows` at all rejects every
# request to both /verify and /settle. See
# packages/facilitator/src/chains/base.ts's `VerifyOptions.escrows` doc
# comment for why (an unauthenticated caller otherwise controls `payTo`).
# ESCROW_ADDRESS_BASE_SEPOLIA=

# --- Hedera (testnet) ---
# Operator account used to submit HCS journal messages.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Set after creating the HCS journal topic (Task 10). Not a secret.
# HCS_TOPIC_ID=
